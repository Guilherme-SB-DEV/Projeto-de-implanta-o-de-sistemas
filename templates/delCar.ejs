<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
   
</body>
<script>

    document.addEventListener('DOMContentLoaded', async()=>{
        const segmentoDir = window.location.pathname.split('/');
        const id = segmentoDir[segmentoDir.length - 4]; 
        const carId = segmentoDir[segmentoDir.length - 1]; 
        try {
    
            const response = await fetch(`/main/${id}/del/${carId}`, {
                method: 'DELETE',
            });
            if(response.ok){
                window.location.href = `/main/${id}`
            }
        } catch (error) {
            console.log(error);
            alert('Erro ao deletar usuário: '+error);
        }
    })
</script>

</html>